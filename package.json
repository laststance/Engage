{
  "name": "engage",
  "main": "expo-router/entry",
  "version": "1.0.15",
  "scripts": {
    "start": "expo start --port 8090",
    "android": "expo run:android --port 8090",
    "ios": "expo run:ios --port 8090",
    "ios:headless": "node scripts/ios-headless.js",
    "web": "expo start --web --port 8090",
    "lint": "expo lint --max-warnings 0",
    "quality:fallow": "pnpm fallow:dead-code && pnpm fallow:dupes",
    "fallow:dead-code": "fallow dead-code --format compact",
    "fallow:dupes": "fallow dupes --format compact --mode mild --min-tokens 90 --min-lines 8 --ignore-imports",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:e2e": "E2E_TEST=true EXPO_PUBLIC_E2E_TEST=true NODE_ENV=production REACT_NATIVE_NO_DEVTOOLS=1 npx expo run:ios --configuration Release --port 8090",
    "build:e2e:clean": "pkill -f 'expo run:ios' || true; (lsof -ti :8090 | xargs kill) 2>/dev/null || true; pnpm test:e2e:clean",
    "build:e2e:restart": "pnpm build:e2e:clean && pnpm build:e2e",
    "test:e2e:clean": "(lsof -ti :8097 | xargs kill) 2>/dev/null || true; pkill -f 'react-devtools' || true; pkill -f 'devtools' || true",
    "test:e2e:production": "maestro test maestro/ios/ --exclude-tags \"smoke,manual,nightly\"",
    "test:e2e:production:single": "maestro test",
    "test:e2e:ios": "pnpm test:e2e:clean && maestro test maestro/ios/ --exclude-tags \"smoke,manual,nightly\"",
    "deploy": "node scripts/deploy.js",
    "deploy:check": "node scripts/deploy.js check",
    "deploy:test": "node scripts/deploy.js test",
    "deploy:version": "node scripts/deploy.js version",
    "deploy:build": "node scripts/deploy.js build",
    "deploy:build:ios": "node scripts/deploy.js build:ios",
    "deploy:build:android": "node scripts/deploy.js build:android",
    "deploy:submit": "node scripts/deploy.js submit",
    "deploy:submit:ios": "node scripts/deploy.js submit:ios",
    "deploy:submit:android": "node scripts/deploy.js submit:android",
    "deploy:full": "node scripts/deploy.js deploy",
    "clean": "rm -rf node_modules pnpm-lock.yaml .expo ios android coverage dist"
  },
  "dependencies": {
    "@expo/dom-webview": "58.0.2",
    "@expo/metro-runtime": "58.0.17",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@laststance/redux-storage-middleware": "0.5.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-vector-icons/ionicons": "^14.0.0",
    "@react-native-vector-icons/material-icons": "^14.0.0",
    "@reduxjs/toolkit": "^2.15.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "expo": "~58.0.26",
    "expo-build-properties": "58.0.12",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-document-picker": "^58.0.5",
    "expo-file-system": "^58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-localization": "^58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-sharing": "^58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "i18next": "^27.2.6",
    "nativewind": "4.2.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^18.0.3",
    "react-native": "0.88.1",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-reanimated": "~4.8.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.14.0",
    "react-redux": "^9.3.1",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "8.0.1",
    "@eslint/compat": "^2.1.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.1",
    "@types/react-test-renderer": "^19.3.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-jest": "^30.5.2",
    "babel-preset-expo": "~58.0.26",
    "eslint": "^10.15.0",
    "eslint-config-expo": "~58.0.4",
    "fallow": "3.47.0",
    "jest": "^30.5.2",
    "jest-transform-stub": "^2.0.0",
    "react-test-renderer": "19.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/jest",
        "jest",
        "react-native-reanimated",
        "typescript"
      ]
    }
  },
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "volta": {
    "node": "26.13.1"
  }
}
