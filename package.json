{
  "name": "engage",
  "main": "expo-router/entry",
  "version": "1.0.11",
  "scripts": {
    "start": "expo start --port 8090",
    "android": "expo run:android --port 8090",
    "ios": "expo run:ios --port 8090",
    "ios:headless": "node scripts/ios-headless.js",
    "web": "expo start --web --port 8090",
    "lint": "expo lint --max-warnings 0",
    "quality:fallow": "pnpm fallow:dead-code && pnpm fallow:dupes",
    "fallow:dead-code": "fallow dead-code --format compact",
    "fallow:dupes": "fallow dupes --format compact --mode mild --min-tokens 90 --min-lines 8 --ignore-imports",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:e2e": "E2E_TEST=true EXPO_PUBLIC_E2E_TEST=true NODE_ENV=production REACT_NATIVE_NO_DEVTOOLS=1 npx expo run:ios --configuration Release --port 8090",
    "build:e2e:clean": "pkill -f 'expo run:ios' || true; (lsof -ti :8090 | xargs kill) 2>/dev/null || true; pnpm test:e2e:clean",
    "build:e2e:restart": "pnpm build:e2e:clean && pnpm build:e2e",
    "test:e2e:clean": "(lsof -ti :8097 | xargs kill) 2>/dev/null || true; pkill -f 'react-devtools' || true; pkill -f 'devtools' || true",
    "test:e2e:production": "maestro test maestro/ios/ --exclude-tags \"smoke,manual,nightly\"",
    "test:e2e:production:single": "maestro test",
    "test:e2e:ios": "pnpm test:e2e:clean && maestro test maestro/ios/ --exclude-tags \"smoke,manual,nightly\"",
    "deploy": "node scripts/deploy.js",
    "deploy:check": "node scripts/deploy.js check",
    "deploy:test": "node scripts/deploy.js test",
    "deploy:version": "node scripts/deploy.js version",
    "deploy:build": "node scripts/deploy.js build",
    "deploy:build:ios": "node scripts/deploy.js build:ios",
    "deploy:build:android": "node scripts/deploy.js build:android",
    "deploy:submit": "node scripts/deploy.js submit",
    "deploy:submit:ios": "node scripts/deploy.js submit:ios",
    "deploy:submit:android": "node scripts/deploy.js submit:android",
    "deploy:full": "node scripts/deploy.js deploy",
    "clean": "rm -rf node_modules pnpm-lock.yaml .expo ios android coverage dist"
  },
  "dependencies": {
    "@expo/dom-webview": "57.0.1",
    "@expo/metro-runtime": "57.0.16",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@laststance/redux-storage-middleware": "0.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-vector-icons/ionicons": "^13.1.4",
    "@react-native-vector-icons/material-icons": "^13.1.4",
    "@reduxjs/toolkit": "^2.13.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-document-picker": "^57.0.3",
    "expo-file-system": "^57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-localization": "^57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-sharing": "^57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.2",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "^19.3.0",
    "babel-jest": "^30.5.2",
    "babel-preset-expo": "~57.0.13",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "fallow": "3.31.0",
    "jest": "^30.5.2",
    "jest-transform-stub": "^2.0.0",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.14",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/jest",
        "jest",
        "react-native-reanimated",
        "typescript"
      ]
    }
  },
  "private": true,
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25",
  "volta": {
    "node": "24.19.0"
  }
}
