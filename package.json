{
  "name": "engage",
  "main": "expo-router/entry",
  "version": "1.0.8",
  "scripts": {
    "start": "expo start --port 8090",
    "android": "expo run:android --port 8090",
    "ios": "expo run:ios --port 8090",
    "ios:headless": "node scripts/ios-headless.js",
    "web": "expo start --web --port 8090",
    "lint": "expo lint --max-warnings 0",
    "quality:fallow": "pnpm fallow:dead-code && pnpm fallow:dupes",
    "fallow:dead-code": "fallow dead-code --format compact",
    "fallow:dupes": "fallow dupes --format compact --mode mild --min-tokens 90 --min-lines 8 --ignore-imports",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:e2e": "E2E_TEST=true EXPO_PUBLIC_E2E_TEST=true NODE_ENV=production REACT_NATIVE_NO_DEVTOOLS=1 npx expo run:ios --configuration Release --port 8090",
    "build:e2e:clean": "pkill -f 'expo run:ios' || true; (lsof -ti :8090 | xargs kill) 2>/dev/null || true; pnpm test:e2e:clean",
    "build:e2e:restart": "pnpm build:e2e:clean && pnpm build:e2e",
    "test:e2e:clean": "(lsof -ti :8097 | xargs kill) 2>/dev/null || true; pkill -f 'react-devtools' || true; pkill -f 'devtools' || true",
    "test:e2e:production": "maestro test maestro/ios/ --exclude-tags \"smoke,manual,nightly\"",
    "test:e2e:production:single": "maestro test",
    "test:e2e:ios": "pnpm test:e2e:clean && maestro test maestro/ios/ --exclude-tags \"smoke,manual,nightly\"",
    "deploy": "node scripts/deploy.js",
    "deploy:check": "node scripts/deploy.js check",
    "deploy:test": "node scripts/deploy.js test",
    "deploy:version": "node scripts/deploy.js version",
    "deploy:build": "node scripts/deploy.js build",
    "deploy:build:ios": "node scripts/deploy.js build:ios",
    "deploy:build:android": "node scripts/deploy.js build:android",
    "deploy:submit": "node scripts/deploy.js submit",
    "deploy:submit:ios": "node scripts/deploy.js submit:ios",
    "deploy:submit:android": "node scripts/deploy.js submit:android",
    "deploy:full": "node scripts/deploy.js deploy",
    "clean": "rm -rf node_modules pnpm-lock.yaml .expo ios android coverage dist"
  },
  "dependencies": {
    "@expo/dom-webview": "57.0.1",
    "@expo/metro-runtime": "57.0.6",
    "@gluestack-ui/core": "^3.0.19",
    "@gluestack-ui/utils": "^3.0.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@react-native-vector-icons/material-icons": "^13.1.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "expo": "~57.0.7",
    "expo-constants": "~57.0.6",
    "expo-device": "~57.0.1",
    "expo-document-picker": "^57.0.1",
    "expo-file-system": "^57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-localization": "^57.0.1",
    "expo-notifications": "~57.0.6",
    "expo-router": "~57.0.7",
    "expo-sharing": "^57.0.6",
    "expo-splash-screen": "~57.0.4",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "i18next": "^26.3.6",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.10",
    "react-native": "0.86.0",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~57.0.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "fallow": "3.6.0",
    "jest": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a",
  "volta": {
    "node": "22.20.0"
  }
}
